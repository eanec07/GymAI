# Use a distinct, high-entropy value in production. Never commit the real value.
SYLRIX_SECRET_KEY=replace-with-a-long-random-secret
SYLRIX_ENV=development
SYLRIX_DATABASE_PATH=/absolute/path/to/persistent/sylrix.db
SYLRIX_COOKIE_SECURE=1
SYLRIX_CSRF_ENABLED=1

# Leave disabled until private-beta invite distribution is ready.
SYLRIX_BETA_MODE=0
SYLRIX_BETA_INVITE_CODE=replace-with-private-invite-code

# Coach can operate in local fallback mode without this key.
OPENAI_API_KEY=
